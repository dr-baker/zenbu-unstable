{
  "name": "zenbu",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "main": "node_modules/@zenbujs/core/dist/setup-gate.mjs",
  "scripts": {
    "dev": "zen dev",
    "build:source": "zen build:source",
    "build:electron": "zen build:electron",
    "publish:source": "zen publish:source",
    "link": "zen link",
    "db:generate": "zen db generate",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "ok=0; for p in plugins/*/tsconfig.json; do echo \"== $p\"; ./node_modules/.bin/tsc --noEmit -p \"$p\" || ok=1; done; exit $ok",
    "lint": "eslint .",
    "ci": "pnpm run typecheck && pnpm run lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zenbujs/core": "0.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "zenbu": {
    "host": ">=0.0.0 <0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:zenbu-labs/zenbu-release.git"
  },
  "pnpm": {
    "overrides": {
      "@zenbujs/core": "link:../../../Developer/zenbu.js/packages/core"
    },
    "onlyBuiltDependencies": [
      "@google/genai",
      "@parcel/watcher",
      "@swc/core",
      "core-js",
      "electron",
      "electron-winstaller",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.13.1"
}
